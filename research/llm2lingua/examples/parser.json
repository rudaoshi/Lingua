                                            "steroid": {"TYPE": "SNP", "ROLE": "HEAD"},
                                            "-": {"TYPE": "ACM_MARKER"}
                                        }
                                    }
                                }
                            },
                            "binding": {"TYPE": "SVP", "ROLE": "PRED"}
                        }
                    },
                    "region": {"TYPE": "SNP", "ROLE": "HEAD"}
                }
            }
        }
