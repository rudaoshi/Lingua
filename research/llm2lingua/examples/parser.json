    {
        "example_info": "Example with relative sentence parsing",
        "sentence": "The house in which she was born is now a museum.",
        "expected_parsing_result": {
            "The house in which she was born is now a museum.": {
                "TYPE": "SS",
                "TerminalPunct": ".",
                "COMPONENTS": {
                    "The house in which she was born": {
                        "TYPE": "NP",
                        "ROLE": "SBJ",
                        "COMPONENTS": {
                            "The house": {
                                "TYPE": "SNP",
                                "ROLE": "HEAD",
                                "COMPONENTS": {
                                    "The": {"TYPE": "DET", "ROLE": "MOD"},
                                    "house": {"TYPE": "SNP", "ROLE": "HEAD"}
                                }
                            },
                            "in which she was born": {
                                "TYPE": "WH_RS",
                                "ROLE": "MOD",
                                "COMPONENTS": {
                                    "in": {"TYPE": "AMPW"},
                                    "which": {
                                        "TYPE": "WH_PHRASE",
                                        "RELATION": [["as:DOBJ", "in"], ["as:REF", "The house"]]
                                    },
                                    "she was born": {
                                        "TYPE": "SS",
                                        "COMPONENTS": {
                                            "she": {"TYPE": "SNP", "ROLE": "SBJ"},
                                            "was born": {"TYPE": "SVP", "ROLE": "SPRED"}
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "is now a museum": {
                        "TYPE": "VP",
                        "ROLE": "PRED",
                        "COMPONENTS": {
                            "is": {"TYPE": "SLVP", "ROLE": "SPRED"},
                            "now": {"TYPE": "SNP", "ROLE": "MOD"},
                            "a museum": {"TYPE": "SNP", "ROLE": "DOBJ"}
                        }
                    }
                }
            }
        }
    },
