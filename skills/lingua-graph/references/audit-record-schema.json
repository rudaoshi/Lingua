{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-dynamics.local/schemas/lingua-audit-record.json",
  "title": "Lingua Per-Line Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "line_number",
    "sentence",
    "structural_status",
    "structural_errors",
    "linguistic_verdict",
    "confidence",
    "errors",
    "suggested_fix",
    "proposed_corrected_sample",
    "review_status",
    "notes"
  ],
  "properties": {
    "line_number": {"type": "integer", "minimum": 1},
    "sentence": {"type": "string"},
    "structural_status": {"type": "string", "enum": ["pass", "fail"]},
    "structural_errors": {"type": "array", "items": {"type": "object"}},
    "linguistic_verdict": {
      "type": "string",
      "enum": ["not_reviewed", "valid", "minor_error", "major_error", "invalid", "not_applicable"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "errors": {"type": "array", "items": {"type": "object"}},
    "suggested_fix": {"type": ["object", "string", "null"]},
    "proposed_corrected_sample": {
      "description": "Complete corrected JSONL sample for fix_proposed/fixed records; null for valid or unresolved records.",
      "type": ["object", "null"]
    },
    "review_status": {
      "type": "string",
      "enum": ["pending_review", "screened", "reviewed", "needs_human_decision", "fix_proposed", "fixed", "skipped"]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
